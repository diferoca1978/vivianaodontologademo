---
import MainLayout from "@/layouts/MainLayout.astro";
import Hero from "@/components/perpage/blanqueamiento/Hero.astro";
import Beneficios from "@/components/perpage/blanqueamiento/Beneficios.astro";
import Pasos from "@/components/perpage/blanqueamiento/Pasos.astro";
import { PAGES } from "@/config/pages";
import { seo } from "@/config/seo";

const head = seo.pageHead(PAGES.blanqueamiento);
const crumbs = [
  { name: "Inicio", path: "/" },
  { name: "Blanqueamiento Dental", path: PAGES.blanqueamiento.path },
];
---

<MainLayout head={head} schemas={[seo.businessRef(), seo.breadcrumbNode(crumbs)]}>
  <Hero crumbs={crumbs} />
  <Beneficios />
  <Pasos />
</MainLayout>
