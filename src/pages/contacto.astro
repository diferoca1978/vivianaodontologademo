---
import MainLayout from "@/layouts/MainLayout.astro";
import Hero from "@/components/perpage/contacto/Hero.astro";
import Datos from "@/components/perpage/contacto/Datos.astro";
import Faq from "@/components/perpage/contacto/Faq.astro";
import { PAGES } from "@/config/pages";
import { seo } from "@/config/seo";

const head = seo.pageHead(PAGES.contacto);
---

<MainLayout head={head} schemas={[seo.businessRef()]}>
  <Hero />
  <Datos />
  <Faq />
</MainLayout>
