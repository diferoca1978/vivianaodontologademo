---
import MainLayout from "@/layouts/MainLayout.astro";
import Hero from "@/components/perpage/home/Hero.astro";
import CalmaActiva from "@/components/perpage/home/CalmaActiva.astro";
import Servicios from "@/components/perpage/home/Servicios.astro";
import Sobre from "@/components/perpage/home/Sobre.astro";
import Testimonios from "@/components/perpage/home/Testimonios.astro";
import FAQ from "@/components/perpage/home/FAQ.astro";
import CtaFinal from "@/components/perpage/home/CtaFinal.astro";
import { PAGES } from "@/config/pages";
import { seo } from "@/config/seo";

const page = PAGES.home;
---

<MainLayout head={seo.pageHead(page)} schemas={seo.homeNodes()}>
  <Hero />
  <CalmaActiva />
  <Servicios />
  <Sobre />
  <Testimonios />
  <CtaFinal />
  <FAQ />
</MainLayout>
