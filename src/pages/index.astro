---
import MainLayout from "@/layouts/MainLayout.astro";
import Hero from "@/components/perpage/home/Hero.astro";
import CalmaActiva from "@/components/perpage/home/CalmaActiva.astro";
import Servicios from "@/components/perpage/home/Servicios.astro";
import Sobre from "@/components/perpage/home/Sobre.astro";
import { generatePageSEO } from "@/config/seo";

const homeSeo = generatePageSEO({
  title: "Home - My Website",
  description: "Welcome to my website. Explore our content and services.",
});
---

<MainLayout seoProps={homeSeo}>
  <Hero />
  <CalmaActiva />
  <Servicios />
  <Sobre />
</MainLayout>
