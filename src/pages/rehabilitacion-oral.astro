---
import MainLayout from "@/layouts/MainLayout.astro";
import Hero from "@/components/perpage/rehabilitacion/Hero.astro";
import CuandoTratamientos from "@/components/perpage/rehabilitacion/CuandoTratamientos.astro";
import ComoSeHace from "@/components/perpage/rehabilitacion/ComoSeHace.astro";
import EnlaceCruzado from "@/components/perpage/rehabilitacion/EnlaceCruzado.astro";
import { PAGES } from "@/config/pages";
import { seo } from "@/config/seo";

const head = seo.pageHead(PAGES.rehabilitacion);
const crumbs = [
  { name: "Inicio", path: "/" },
  { name: "Rehabilitación Oral", path: PAGES.rehabilitacion.path },
];
---

<MainLayout head={head} schemas={[seo.businessRef(), seo.breadcrumbNode(crumbs)]}>
  <Hero crumbs={crumbs} />
  <CuandoTratamientos />
  <ComoSeHace />
  <EnlaceCruzado />
</MainLayout>
