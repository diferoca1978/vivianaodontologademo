---
import ToothLogo from "@/assets/icons/tooth-logo.svg";
import { Image } from "astro:assets";
import firstCheckPhoto from "@/assets/images/firstcheck2.webp";
import calmPhoto from "@/assets/images/calmenvironment.webp";
import aftercarePhoto from "@/assets/images/postservice.webp";

// Copy: docs/brief/textos-sitio.md §2 Blanqueamiento Dental › Cómo se hace (texto anterior) (verbatim).
// Design: references/blanqueamiento-como-se-hace/04-dentica-pinned-steps.png (spec 02) — one step per
// viewport, full-bleed photo under a charcoal overlay, giant number bottom-left, title and text
// bottom-right. The numbers are the list ordinals, so they are aria-hidden (the <ol> already says it).
// Base layout is the stacked one, visible without JS. The pinned stage (panels overlaid, clip-path
// wipe) is switched on from src/utils/scripts/animations/blanqueamiento-dental/pasos.ts through the
// data-pasos-* hooks below. The photos are decorative next to the step text, hence alt="".
interface Step {
  title: string;
  text: string;
  image: ImageMetadata;
}

const steps: Step[] = [
  {
    title: "Valoración inicial",
    text: "Revisamos el estado de tu esmalte y encías antes de recomendar cualquier tratamiento.",
    image: firstCheckPhoto,
  },
  {
    title: "Ambiente de calma",
    text: "Aromaterapia, música y audífonos de cancelación de ruido durante todo el procedimiento.",
    image: calmPhoto,
  },
  {
    title: "Aplicación y seguimiento",
    text: "Control de sensibilidad y recomendaciones de cuidado para mantener el resultado.",
    image: aftercarePhoto,
  },
];
---

<section
  id="como-se-hace"
  aria-labelledby="como-se-hace-title"
  class="bg-charcoal text-ivory"
  data-pasos
>
  <div
    class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 pt-20 pb-12 xl:px-8"
  >
    <h2
      id="como-se-hace-title"
      class="text-4xl leading-tight font-medium tracking-tight sm:text-5xl"
    >
      Cómo se hace
    </h2>
    <ToothLogo data-pasos-logo aria-hidden="true" class="size-16 shrink-0 text-turquoise sm:size-32" />
  </div>

  <ol class="group/stage relative data-stage:overflow-hidden" role="list" data-pasos-stage>
    {
      steps.map((step, index) => (
        <li
          class="relative isolate flex aspect-2/3 min-h-128 overflow-hidden sm:aspect-4/5 md:aspect-auto md:h-svh md:min-h-160 group-data-stage/stage:absolute group-data-stage/stage:inset-0 group-data-stage/stage:h-full group-data-stage/stage:min-h-0"
          data-pasos-panel
        >
          <div aria-hidden="true" class="absolute inset-0 -z-10" data-pasos-media>
            <Image
              src={step.image}
              alt=""
              widths={[640, 1024, 1536, step.image.width]}
              sizes="100vw"
              class="h-full w-full object-cover"
            />
            <div class="absolute inset-0 bg-charcoal/35" />
            <div class="absolute inset-0 bg-linear-to-t from-charcoal/95 via-charcoal/60 via-45% to-transparent md:from-charcoal/90 md:via-charcoal/40" />
          </div>

          <div class="mx-auto flex w-full max-w-7xl flex-col justify-end gap-6 px-4 pb-10 sm:pb-12 md:grid md:grid-cols-12 md:items-end md:gap-8 md:pb-16 lg:pb-20 xl:px-8">
            <span
              aria-hidden="true"
              class="font-cormorant text-8xl leading-none font-light tracking-tight text-ivory sm:text-9xl md:col-span-5 lg:col-span-6"
              data-pasos-number
            >
              {String(index + 1).padStart(2, "0")}
            </span>

            <div class="max-w-md md:col-span-7 md:pb-3 lg:col-span-5 lg:col-start-7" data-pasos-text>
              <h3 class="text-3xl leading-tight font-medium text-ivory sm:text-4xl lg:text-5xl">
                {step.title}
              </h3>
              <p class="mt-4 text-base leading-relaxed text-ivory/90 sm:text-lg">
                {step.text}
              </p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<script>
  import "@/utils/scripts/animations/blanqueamiento-dental/pasos";
</script>
