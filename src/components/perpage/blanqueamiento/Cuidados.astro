---
// Copy: docs/brief/textos-blanqueamiento.md › Cuidados después del blanqueamiento dental
// (verbatim, in the brief's order).
// Design: a soft turquoise band right after Contraindicaciones (charcoal), so the page keeps
// alternating tones. The h2 sits on the left (sticky on lg); the five care tips on the right as a
// checklist, each with a decorative check icon and a hairline divider, echoing the numbered list of
// Contraindicaciones; stacked below lg. No animation.
import CircleCheck from "@/assets/icons/circle-check.svg";

const items: string[] = [
  "Modera el café, el té, el vino tinto y los alimentos pigmentantes los primeros días.",
  "Evita fumar: favorece las manchas.",
  "Limita los alimentos ácidos, como los cítricos, si tienes sensibilidad.",
  "Usa crema dental con flúor y mantén una buena higiene oral.",
  "Consúltanos si la sensibilidad es intensa o persistente.",
];
---

<section id="cuidados" aria-labelledby="cuidados-title" class="bg-turquoise-light/40">
  <div class="mx-auto max-w-7xl px-4 py-20 sm:py-24 lg:py-28 xl:px-8">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <div class="border-l-2 border-turquoise-dark pl-6 sm:pl-8 lg:sticky lg:top-32">
          <h2
            id="cuidados-title"
            class="text-4xl leading-tight font-medium tracking-tight text-balance text-charcoal sm:text-5xl"
          >
            Cuidados después del blanqueamiento dental
          </h2>
        </div>
      </div>

      <div class="lg:col-span-7">
        <ul class="divide-y divide-charcoal/10 border-y border-charcoal/10" role="list">
          {
            items.map((item) => (
              <li class="flex items-start gap-5 py-6 sm:gap-8 sm:py-7">
                <span
                  aria-hidden="true"
                  class="flex size-10 shrink-0 items-center justify-center rounded-full bg-ivory shadow-sm shadow-turquoise-dark/10 sm:size-12"
                >
                  <CircleCheck class="size-5 text-turquoise-dark sm:size-6" />
                </span>
                <p class="pt-1.5 text-base leading-relaxed text-pretty text-charcoal sm:pt-2 sm:text-lg">
                  {item}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
