---
// "Antes y después" of the whitening (spec 07). Data only: the photos, alt texts and labels come
// from specs/07-blanqueamiento-antes-despues-scroll.md § Source of the content; the layout and the
// scroll motion live in the generic ui/sections/BeforeAfter. The section has no heading on purpose
// (the only visible text is the two labels), so it is named through aria-label.
import BeforeAfter from "@/components/ui/sections/BeforeAfter.astro";
import beforePhoto from "@/assets/images/beforewhitening.webp";
import afterPhoto from "@/assets/images/afterwithening.webp";
---

<BeforeAfter
  id="antes-y-despues"
  ariaLabel="Antes y después del blanqueamiento dental"
  before={beforePhoto}
  after={afterPhoto}
  beforeAlt="Sonrisa antes del blanqueamiento dental"
  afterAlt="La misma sonrisa después del blanqueamiento dental"
  beforeLabel="Antes"
  afterLabel="Después"
/>
