---
import { Image } from "astro:assets";
import type { BreadcrumbItem } from "@shine/seo-core";
import Breadcrumb from "@/components/ui/navigation/Breadcrumb.astro";
import { COMPANY } from "@/config/company";
import { PAGES } from "@/config/pages";
import WhatsappIcon from "@/assets/icons/whatsApp.svg";
import MoodSearch from "@/assets/icons/moodsearch.svg";
import ThreeFingers from "@/assets/icons/threefingers.svg";
import heroPhoto from "@/assets/images/hero-blanqueamiento.webp";

// Copy: docs/brief/textos-blanqueamiento.md, top section (H1, subtítulo, 3 puntos, CTA); the brief's
// typo "revision" is written "revisión" and "3 modalidades" is "Tres modalidades". The H1 comes from
// PAGES.blanqueamiento.h1. The intro paragraph lives in Intro.astro (specs/03), not in the hero.
// Layout: references/blanqueamiento-hero/01-odyssee.png. A full-bleed close-up photo with the
// copy laid over it. The photo's left third is clean white, so the copy sits there in charcoal
// (the reference's white-on-photo text is the contrast problem referencias.md says to avoid).
// Below lg it stacks: copy on ivory, photo underneath.
interface Props {
  crumbs: BreadcrumbItem[];
}

const { crumbs } = Astro.props;

interface Highlight {
  lead: string;
  text: string;
  icon: typeof ThreeFingers
}

const highlights: Highlight[] = [
  {
    lead: "Valoración clínica previa:",
    text: "revisión exhaustiva de tus dientes antes de recomendarte una opción.",
    icon: MoodSearch
  },
  { lead: "Tres modalidades:", text: "en consultorio, en casa o mixto.", icon: ThreeFingers },
];

const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-charcoal";

// The H1 stays PAGES.blanqueamiento.h1; only its last word is set in italic.
const h1Words = PAGES.blanqueamiento.h1.split(" ");
const h1Accent = h1Words.pop();
const h1Lead = h1Words.join(" ");
---

<section
  aria-labelledby="blanqueamiento-title"
  class="relative isolate flex flex-col overflow-hidden bg-ivory lg:h-screen"
>
  <!-- Photo: below the copy on mobile, full-bleed behind it on desktop -->
  <div class="relative order-last aspect-4/3 w-full overflow-hidden lg:absolute lg:inset-0 lg:left-32 lg:-z-10 lg:order-0 lg:aspect-auto">
    <Image
      data-hero-image
      src={heroPhoto}
      alt="Primer plano de una sonrisa con dientes blancos y parejos"
      priority
      widths={[640, 1024, 1536, heroPhoto.width]}
      sizes="100vw"
      class="h-full w-full object-cover object-right"
    />
    <!-- Ivory fade on top (below lg) so the photo melts into the copy above it -->
    <div
      aria-hidden="true"
      class="absolute inset-x-0 top-0 h-1/2 bg-linear-to-b from-ivory to-transparent lg:hidden"
    ></div>
    <!-- Ivory fade on the left (lg only) so the copy keeps its contrast and the white of the
         photo melts into the page background -->
    <div
      aria-hidden="true"
      class="absolute inset-0 hidden bg-linear-to-r from-ivory from-30% via-ivory/60 via-45% to-transparent lg:block"
    ></div>
    <!-- Ivory fade at the bottom so the photo melts into the next section (same as the home hero) -->
    <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-ivory to-transparent"></div>
  </div>

  <div class="mx-auto flex w-full max-w-7xl flex-1 flex-col lg:relative px-4 pt-8 pb-10 sm:pt-10 lg:pt-10 lg:pb-16 xl:px-8">
    <Breadcrumb items={crumbs} />

    <!-- Desktop: subtitle, H1 and highlights left at mid-height, CTA pinned bottom-right -->
    <div class="mt-10 flex flex-col gap-8 lg:my-auto lg:pt-8">
      <div class="flex max-w-xl flex-col gap-6 lg:max-w-lg">
        <p data-hero-item class="font-cormorant text-2xl leading-snug font-medium text-turquoise-dark italic sm:text-3xl">
          Una sonrisa más luminosa, sin perder su apariencia natural.
        </p>
        <h1
          id="blanqueamiento-title"
          data-hero-item
          class="text-5xl leading-none font-medium tracking-tight text-balance text-charcoal sm:text-6xl xl:text-7xl"
        >
          {h1Lead} <em class="font-normal block">{h1Accent}</em>
        </h1>
        
        <ul role="list" class="flex max-w-md flex-col gap-3">
          {
            highlights.map(({ lead, text, icon: Icon }) => (
               
                <li data-hero-highlight class="flex items-start gap-3 text-sm leading-snug text-charcoal sm:text-base">
                  <span aria-hidden="true" class="mt-0.5 size-4 shrink-0 text-turquoise-dark sm:size-5">
                    <Icon class="size-full" />
                  </span>
                  <span>
                    <strong class="font-semibold">{lead}</strong> {text}
                  </span>
                </li>
            
              ))
          }
        </ul>
      </div>
      <!-- CTA pinned bottom-right on lg -->
      <div class="flex max-w-md flex-col gap-6 lg:absolute lg:right-0 lg:bottom-16 lg:rounded-3xl lg:p-8">
        <div data-hero-cta>
          <a
            href={COMPANY.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "inline-flex items-center justify-center gap-3 rounded-full bg-turquoise px-7 py-4 font-medium whitespace-nowrap text-ivory shadow-lg shadow-turquoise/20 transition-colors duration-300 hover:bg-turquoise-dark motion-reduce:transition-none",
              focusRing,
            ]}
          >
            <WhatsappIcon class="size-5" aria-hidden="true" />
            Agenda tu valoración
            <span class="sr-only">(se abre en una pestaña nueva)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import "@/utils/scripts/animations/blanqueamiento-dental/hero";
</script>
