---
import { Image } from "astro:assets";
import { COMPANY } from "@/config/company";
import { PAGES } from "@/config/pages";
import heroPhoto from "@/assets/images/Hero-home-reference-opt1.webp";
import WhatsappIcon from "@/assets/icons/whatsApp.svg";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import Calendar from "@/assets/icons/calendar.svg";
import Award from "@/assets/icons/award.svg";
import MapPin from "@/assets/icons/map-pin.svg";

// Copy: docs/brief/textos-sitio.md §1 Inicio › Hero (verbatim, one text node per string).
// Layout (references/Hero-home-reference.png): copy on the left, the photo bleeding off the
// right edge and fading into the ivory page. Below lg it stacks: copy, then the photo.
// Motion lives in src/utils/scripts/animations/home/hero.ts (data-hero-* hooks).

interface Highlight {
  text: string;
  icon: typeof Calendar;
  href?: string; // external, opens in a new tab
}

// The address links to the Google Business Profile, as it does in the footer and the FAQ.
const highlights: Highlight[] = [
  { text: "+12 años en odontología", icon: Calendar },
  { text: "Especialista en Rehabilitación Oral desde 2019", icon: Award },
  {
    text: `${COMPANY.business.address.street}, Norte de Bogotá`,
    icon: MapPin,
    href: COMPANY.socialMedia.googleBusiness,
  },
];

const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-charcoal";
---

<section aria-labelledby="hero-title" class="relative isolate overflow-hidden bg-ivory">
  <!-- Soft turquoise glow behind the copy -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -top-40 -left-40 -z-10 size-112 rounded-full bg-turquoise-light/40 blur-3xl"
  >
  </div>

  <div class="mx-auto flex max-w-7xl flex-col px-4 lg:min-h-176 lg:flex-row lg:items-center xl:px-8">
    <div class="relative z-10 pt-12 pb-10 sm:pt-16 lg:w-1/2 lg:py-20 lg:pr-10">
      <h1
        id="hero-title"
        data-hero-item
        class="text-4xl leading-tight font-medium tracking-tight text-balance sm:text-5xl xl:text-6xl"
      >
        {PAGES.home.h1}
      </h1>

      <p
        data-hero-item
        class="mt-6 border-l-2 border-turquoise pl-4 text-lg leading-snug font-medium text-turquoise-dark sm:text-xl"
      >
        Odontología de Calma Activa: cuidamos tu sonrisa y tu tranquilidad.
      </p>

      <p data-hero-item class="mt-6 max-w-xl text-base leading-relaxed text-charcoal/80 sm:text-lg">
        No solo transformamos sonrisas: cuidamos la tranquilidad de las personas que hay detrás de ellas. Consultorio particular en Chicó, Bogotá, con tecnología sin dolor y atención personalizada.
      </p>

      <div data-hero-item class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <a
          href={COMPANY.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "inline-flex items-center justify-center gap-3 rounded-full whitespace-nowrap bg-turquoise px-7 py-4 font-medium text-ivory shadow-lg shadow-turquoise/20 transition-colors duration-300 hover:bg-turquoise-dark motion-reduce:transition-none",
            focusRing,
          ]}
        >
          <WhatsappIcon class="size-5" aria-hidden="true" />
          Agendar por WhatsApp
          <span class="sr-only">(se abre en una pestaña nueva)</span>
        </a>

        <a
          href="#servicios"
          class:list={[
            "group inline-flex items-center justify-center gap-2 rounded-full whitespace-nowrap border border-turquoise-dark px-7 py-4 font-medium text-turquoise-dark transition-colors duration-300 hover:bg-turquoise-light/50 motion-reduce:transition-none",
            focusRing,
          ]}
        >
          Conocer servicios
          <ArrowUp
            class="size-4 rotate-180 transition-transform duration-300 group-hover:translate-y-0.5 motion-reduce:transition-none"
            aria-hidden="true"
          />
        </a>
      </div>

      <ul
        class="mt-12 grid gap-x-8 gap-y-5 border-t border-gray-light pt-8 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3"
      >
        {
          highlights.map(({ text, icon: Icon, href }) => {
            const Item = href ? "a" : "div";
            return (
              <li data-hero-highlight>
                <Item
                  href={href}
                  target={href ? "_blank" : undefined}
                  rel={href ? "noopener noreferrer" : undefined}
                  class:list={[
                    "group flex items-center gap-4 sm:flex-col sm:items-start lg:flex-row lg:items-center xl:flex-col xl:items-start",
                    href && [
                      "rounded-lg transition-colors duration-300 hover:text-turquoise-dark motion-reduce:transition-none",
                      focusRing,
                    ],
                  ]}
                >
                  <span class="flex size-11 shrink-0 items-center justify-center rounded-full bg-turquoise-light/60 text-turquoise-dark">
                    <Icon class="size-5 transition-transform duration-300 group-hover:scale-110 motion-reduce:transition-none" aria-hidden="true" />
                  </span>
                  <span
                    class:list={[
                      "text-base leading-snug font-medium text-pretty",
                      href,
                    ]}
                  >
                    {text}
                    {href && <span class="sr-only">(ver en Google Maps, se abre en una pestaña nueva)</span>}
                  </span>
                </Item>
              </li>
            );
          })
        }
      </ul>
    </div>

    <div
      data-hero-photo
      class="relative -mx-4 aspect-4/5 overflow-hidden sm:aspect-4/3 lg:absolute lg:inset-y-0 lg:right-0 lg:mx-0 lg:aspect-auto lg:w-1/2"
    >
      <Image
        src={heroPhoto}
        alt={`${COMPANY.name}, odontóloga, sentada junto a la silla dental en un consultorio luminoso`}
        priority
        widths={[480, 768, 1024, heroPhoto.width]}
        sizes="(min-width: 1024px) 50vw, 100vw"
        data-hero-image
        class="h-full w-full object-cover object-top"
      />
      <!-- Fades that melt the photo into the ivory page: top (stacked), left (side by side), bottom -->
      <div aria-hidden="true" class="absolute inset-x-0 top-0 h-1/3 bg-linear-to-b from-ivory to-transparent lg:hidden">
      </div>
      <div
        aria-hidden="true"
        class="absolute inset-y-0 left-0 hidden w-1/3 bg-linear-to-r from-ivory via-ivory/60 to-transparent lg:block"
      >
      </div>
      <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-24 bg-linear-to-t from-ivory to-transparent"></div>
    </div>
  </div>
</section>

<script>
  import "@/utils/scripts/animations/home/hero";
</script>
