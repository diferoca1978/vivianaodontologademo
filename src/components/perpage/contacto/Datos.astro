---
import { COMPANY } from "@/config/company";
import { formatOpeningHours } from "@/utils/openingHours";
import WhatsApp from "@/assets/icons/whatsApp.svg";
import Mail from "@/assets/icons/mail.svg";
import MapPin from "@/assets/icons/map-pin.svg";
import MapIcon from "@/assets/icons/map.svg";
import Clock from "@/assets/icons/clock.svg";
import CreditCard from "@/assets/icons/creditcardpayment.svg";
import Visa from "@/assets/icons/visa.svg";
import Mastercard from "@/assets/icons/mastercard.svg";
import AmericanExpress from "@/assets/icons/americanexpress.svg";
import Nequi from "@/assets/icons/nequi.svg";
import Daviplata from "@/assets/icons/daviplata.svg";
import Instagram from "@/assets/icons/instagram.svg";
import Tiktok from "@/assets/icons/tiktok.svg";
import ArrowUpRight from "@/assets/icons/arrow-up-right.svg";

// Copy: docs/brief/textos-sitio.md §4 Contacto › Datos de contacto. Every business value comes
// from COMPANY (phone, WhatsApp, email, address, social profiles, Google Business Profile) and the
// opening hours from COMPANY.business.hours (Google Business Profile, client-gaps.md #1, still to
// be confirmed). The payment methods are the brief's copy, verbatim (no COMPANY field holds them).
// Map (decided, option A): a decorative card, not a real map and no iframe, so no third-party
// scripts or cookies. It links to COMPANY.socialMedia.googleBusiness (client-gaps.md #7). The street
// lines are aria-hidden; "Chicó" is the brief's neighbourhood (textos §1, arquitectura §1).
// The scroll reveal lives in src/utils/scripts/animations/contacto/datos.ts (data-datos-item hooks).

// The WhatsApp card shows the number its link opens, derived from COMPANY.whatsapp
// (wa.me/57XXXXXXXXXX → "+57 XXX XXX XXXX"), so it never drifts from the link.
const waDigits = COMPANY.whatsapp.replace(/\D/g, "");
const whatsappDisplay = waDigits.replace(/^(\d{2})(\d{3})(\d{3})(\d{4})$/, "+$1 $2 $3 $4");

const { address } = COMPANY.business;
const fullAddress = `${address.street}, ${address.city}`;
const openingHours = formatOpeningHours(COMPANY.business.hours ?? []);
const paymentMethods =
  "Recibimos todas las tarjetas y código QR (no EPS ni seguros)";
const paymentBrands = [
  { name: "Visa", Icon: Visa, size: "h-10 w-20" },
  { name: "Mastercard", Icon: Mastercard, size: "h-10 w-20" },
  { name: "American Express", Icon: AmericanExpress, size: "h-8 w-16" },
  { name: "Nequi", Icon: Nequi, size: "h-8 w-16" },
  { name: "Daviplata", Icon: Daviplata, size: "h-8 w-16" },
];

const socials = [
  { name: "Instagram", href: COMPANY.socialMedia.instagram, Icon: Instagram },
  { name: "TikTok", href: COMPANY.socialMedia.tiktok, Icon: Tiktok },
];

const focusRing =
  "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-turquoise-dark";
const linkClass = `font-medium text-ivory underline decoration-turquoise/50 decoration-2 underline-offset-4 transition-colors duration-300 hover:text-turquoise hover:decoration-turquoise motion-reduce:transition-none ${focusRing}`;
const iconClass =
  "flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-turquoise text-charcoal";
const labelClass =
  "flex items-center gap-4 text-sm font-semibold tracking-widest text-gray-neutral uppercase";
const newTab = "(se abre en una pestaña nueva)";
---

<section
  id="datos-de-contacto"
  aria-labelledby="datos-title"
  class="relative isolate bg-charcoal text-ivory"
>
  <div class="mx-auto max-w-7xl px-4 py-20 sm:py-24 xl:px-8">
    <div class="max-w-2xl" data-datos-item>
      <h2
        id="datos-title"
        class="text-4xl leading-tight font-medium tracking-tight text-balance sm:text-5xl"
      >
        Datos de contacto
      </h2>
    </div>

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <!-- Contact details -->
      <dl class="grid gap-x-10 divide-y divide-gray-light border-t border-gray-light sm:grid-cols-2 sm:divide-y-0 lg:col-span-7">
        <div class="flex flex-wrap justify-center gap-x-10 sm:col-span-2">
          <div data-datos-item class="flex min-w-0 basis-64 grow flex-col gap-2 py-6 sm:border-b sm:border-gray-light">
            <dt class={labelClass}>
              <span class={iconClass} aria-hidden="true">
                <WhatsApp class="h-5 w-5" />
              </span>
              WhatsApp
            </dt>
            <dd class="pl-15">
              <a
                href={COMPANY.whatsapp}
                target="_blank"
                rel="noopener noreferrer"
                class={linkClass}
              >
                {whatsappDisplay}
                <span class="sr-only">{newTab}</span>
              </a>
            </dd>
          </div>

          <div data-datos-item class="flex min-w-0 basis-64 grow flex-col gap-2 py-6 sm:border-b sm:border-gray-light">
            <dt class={labelClass}>
              <span class={iconClass} aria-hidden="true">
                <Mail class="h-5 w-5" />
              </span>
              Correo
            </dt>
            <dd class="min-w-0 pl-15 wrap-break-words">
              <a href={`mailto:${COMPANY.email}`} class={linkClass}>
                {COMPANY.email}
              </a>
            </dd>
          </div>

          {openingHours.length > 0 && (
            <div data-datos-item class="flex basis-full flex-col items-center gap-2 py-6">
              <dt id="datos-horario" class={labelClass}>
                <span class={iconClass} aria-hidden="true">
                  <Clock class="h-5 w-5" />
                </span>
                Horario de atención
              </dt>
              <dd>
                <table aria-labelledby="datos-horario" class="text-left">
                  <tbody>
                    {openingHours.map(({ days, hours }) => (
                      <tr>
                        <th
                          scope="row"
                          class="py-0.5 pr-4 font-normal text-ivory"
                        >
                          {days}
                        </th>
                        <td class="py-0.5 whitespace-nowrap text-ivory/70">
                          {hours}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </dd>
            </div>
          )}
        </div>
      </dl>

      <!-- Map card: decorative illustration, opens the Google Business Profile -->
      <div data-datos-item class="flex flex-col gap-4 lg:col-span-5">
        <a
          href={COMPANY.socialMedia.googleBusiness}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Ver ${fullAddress} en Google Maps ${newTab}`}
          class:list={[
            "group relative isolate block aspect-4/3 overflow-hidden rounded-3xl",
            "transition-shadow duration-300 hover:shadow-xl hover:shadow-turquoise/20 motion-reduce:transition-none",
            focusRing,
          ]}
        >
          <span
            class="absolute inset-0 flex flex-col items-center justify-center gap-3"
            aria-hidden="true"
          >
            <MapIcon class=" size-40 text-turquoise-dark drop-shadow-md transition-transform duration-300 group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0" />
            <span
              aria-hidden="true"
              class="inline-flex items-center gap-2 rounded-full bg-ivory px-4 py-2 text-sm font-semibold text-charcoal shadow-md transition-colors duration-300 group-hover:bg-turquoise group-hover:text-ivory motion-reduce:transition-none"
            >
              Ver en Google Maps
              <ArrowUpRight class="h-4 w-4" />
            </span>
          </span>
        </a>
        <p class="flex items-start gap-2 text-ivory/80">
          <MapPin
            class="mt-1 h-4 w-4 shrink-0 text-turquoise-dark"
            aria-hidden="true"
          />
          {fullAddress} (Chicó).
        </p>
      </div>
    </div>

    <dl class="mt-12 flex flex-wrap justify-center gap-x-16 gap-y-6 border-y border-gray-light py-6">
      <div data-datos-item class="flex min-w-0 basis-64 grow flex-col gap-2">
        <dt class={labelClass}>
          <span class={iconClass} aria-hidden="true">
            <CreditCard class="h-5 w-5" />
          </span>
          Medios de pago
        </dt>
        <dd class="pl-15 text-ivory first-letter:uppercase">
          {paymentMethods}
        </dd>
        <dd class="flex flex-wrap items-center justify-center gap-4 sm:justify-start sm:pl-15">
          {
            paymentBrands.map(({ name, Icon, size }) => (
              <Icon class={`${size} text-turquoise`} aria-label={name} role="img" />
            ))
          }
        </dd>
      </div>

      <div data-datos-item class="flex min-w-0 basis-64 grow flex-col gap-2">
        <dt class={labelClass}>
          
          Síguenos en redes
        </dt>
        <dd class="flex items-center gap-3">
          {socials.map(({ name, href, Icon }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${name} ${newTab}`}
              class:list={[
                "inline-flex h-11 w-11 items-center justify-center rounded-full bg-turquoise text-charcoal transition-colors duration-300 hover:bg-ivory hover:text-charcoal motion-reduce:transition-none",
                focusRing,
              ]}
            >
              <Icon class="h-5 w-5" aria-hidden="true" />
            </a>
          ))}
        </dd>
      </div>
    </dl>
  </div>
</section>

<script>
  import "@/utils/scripts/animations/contacto/datos";
</script>
