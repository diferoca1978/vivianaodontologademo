---
import SeoHead from "@shine/seo-core/components/SeoHead.astro";
import type { HeadData, JsonLdNode } from "@shine/seo-core";
import { LOCALE } from "@/config/company";
import { Font } from "astro:assets";
import "@/styles/global.css";

import Navbar from "@/components/global/NavBar.astro";
import Footer from "@/components/global/Footer.astro";
import WhatsApp from "@/components/ui/WhatsApp.astro";

// head: seo.pageHead(PAGES.x) or seo.notFoundHead(). schemas: the page's JSON-LD nodes
// (seo.homeNodes() on '/'), emitted as one @graph. SeoHead emits none on a noindex page.
interface Props {
  head: HeadData;
  schemas?: JsonLdNode[];
}

const { head, schemas } = Astro.props;
---

<!doctype html>
<html lang={LOCALE} class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1"/>

    <!-- Google Tag Manager -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-T5NZ2BZC"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>

    <!-- SEO Head -->
    <SeoHead head={head} schemas={schemas} />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <Font cssVariable="--font-cormorant" />
    <Font cssVariable="--font-raleway" />

    <!-- SiteMap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- llms.txt -->
    <link rel="alternate" type="text/plain" href="/llms.txt" />

    <script>
      import "@/utils/scripts/lennis.js";
    </script>
  </head>

  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsApp />
  </body>
</html>
